<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_lighteditor._tcp</string>
	</array>
	<!-- lighteditor://edit?… opens a photo in the editor (the share extension, PhotoHandoff). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lighteditor</string>
			</array>
		</dict>
	</array>
	<!-- Bulk edits and imports keep running in the background (ContinuedProcessing.swift). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).bulk.*</string>
	</array>
</dict>
</plist>
